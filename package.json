{
  "name": "@juninmd/aniversario-core",
  "version": "1.0.0",
  "description": "Anniversary/Birthday management core API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:security": "jest --testPathPattern='__tests__/.*security.*\\.test\\.ts$' --verbose",
    "test:coverage": "jest --coverage",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": ["anniversary", "birthday", "api"],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.1",
    "express-validator": "7.2.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "26.0.0",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "10.6.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.4",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
